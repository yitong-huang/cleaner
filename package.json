{
  "name": "cleaner",
  "private": true,
  "version": "0.1.0",
  "description": "macOS 可清理空间检查客户端",
  "author": "Cleaner",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/electron-dev.mjs",
    "build": "tsc -b && vite build",
    "build:app": "bash scripts/make-dmg.sh",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.cleaner.macos",
    "productName": "Cleaner",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/bin/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Cleaner 需要控制「照片」应用，以便将所选图片移到「最近删除」并同步到 iCloud。",
        "NSPhotoLibraryUsageDescription": "Cleaner 需要访问照片图库，以便把你选中的相似照片移到「最近删除」并同步到 iCloud。"
      }
    }
  }
}
